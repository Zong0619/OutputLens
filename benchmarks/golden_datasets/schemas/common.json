{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.outputlens.org/schemas/golden-dataset-common.json",
  "title": "Golden Dataset Common Structure",
  "description": "Shared structure for all OutputLens golden datasets.",

  "defs": {
    "dataset_envelope": {
      "type": "object",
      "required": ["dataset_id", "version", "description", "items"],
      "properties": {
        "dataset_id": {
          "type": "string",
          "enum": ["GOLD-CLAIM", "GOLD-CONCEPT", "GOLD-ESTABLISHED",
                   "GOLD-EVIDENCE", "GOLD-NOVELTY", "GOLD-PUNCHLIST"]
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "description": {"type": "string", "minLength": 10},
        "annotator_count": {"type": "integer", "minimum": 1},
        "inter_annotator_agreement": {
          "type": "object",
          "properties": {
            "metric": {"type": "string"},
            "value": {"type": "number"},
            "note": {"type": "string"}
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["item_id", "response_text"],
            "properties": {
              "item_id": {"type": "string"},
              "response_text": {"type": "string", "minLength": 10},
              "source_model": {"type": "string"},
              "domain": {"type": "string"},
              "prompt": {"type": "string"},
              "annotations": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
